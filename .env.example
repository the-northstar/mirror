# YouCam / Perfect Corp API credentials.
# Get these at https://yce.perfectcorp.com/api-console -> API Keys.
# These are SERVER-SIDE ONLY. Never prefix them with VITE_, or Vite will
# inline them into the public client bundle.
YOUCAM_API_KEY=
YOUCAM_API_SECRET=

# Optional. Adds a stylist layer on top of the measurements: the model picks one
# product per aisle from the shortlist code already ranked, and writes how they
# work together. Without it the app still recommends, using the top colour
# match, and says so. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
